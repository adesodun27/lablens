# Add at least ONE of these. The app tries them in this order and moves on if one is busy or out of quota.

# 1) Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   # optional; otherwise picked automatically

# 2) Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b      # must be a vision model

# 3) OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Optional: 1 = no API calls, canned sample data (UI work / demo backup)
# GEMINI_MOCK=1
